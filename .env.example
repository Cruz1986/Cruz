# Copy to .env.local. Never commit real values.

# Public site URL (absolute links, auth redirects). Add <SITE_URL>/api/auth/callback
# to Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). The publishable (anon) key is safe in the browser;
# row level security protects the data. Leave empty to run without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put the service role / secret key in a NEXT_PUBLIC_ variable.

# Address shown on the privacy page for questions about personal data (optional).
CONTACT_EMAIL=

# --- Reminders and announcements (server only; see docs/ARCHITECTURE.md › Notifications) ---
# Service role key, used only by the scheduled job that sends reminders (bypasses row level security).
SUPABASE_SERVICE_ROLE_KEY=
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" (openssl rand -hex 32; see docs/DEPLOYMENT.md).
CRON_SECRET=
# Web Push keys: `npx web-push generate-vapid-keys`. The public key is safe in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# "log" prints messages instead of sending them (development).
NOTIFICATION_PROVIDER=
