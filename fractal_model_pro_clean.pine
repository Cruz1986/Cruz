ui_bu_bdy   = input.color(#70a880, "Body", inline = "b", group = G_PANE)
ui_be_bdy   = input.color(#000000, "", inline = "b", group = G_PANE)
ui_bu_brd   = input.color(#5d606b, "Border", inline = "r", group = G_PANE)
