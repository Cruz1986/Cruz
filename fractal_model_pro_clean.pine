//@version=6
indicator("Fractal Model [Pro+ Clean]", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

// ══════════════════════════════════════════════════════════════════════════════
// Fractal Model [Pro+ Clean]
//  Pro+ architecture (pattern-first T-Spots on the primary fractal HTF) with:
//   - 3 HTF panes (horizontal or stacked), single-HTF mode, pane FVG / VI, pane sweeps, EQ lines,
//     HTF start lines, TF label + countdown, C1..C4 tags
//   - T-Spot: C3 (sweep), C4 (expansive), mid-level; Silver T-Spot; hide / delete against;
//     C2 / C3 / C4 labels with state colours (gray / orange consolidating / red failed)
//   - CISD (chain based), IC-CISD, protected-swing dot, projections, touch confirmation line,
//     formation liquidity (until taken)
//   - SMT on the SAME fractal HTF (+ optional pivot SMT) with the Pro+ auto pairs
//   - BSL / SSL rework (swing pivots + EQH/EQL, previous fractal-candle H/L, PDH/PDL, PWH/PWL;
//     nearest N only, deleted when swept)
//   - FVG rework (chart + HTF gaps, partial fills cut the box, a close through DELETES it - no iFVG)
//   - Everything transient is drawn from a bin on the last bar: clean chart
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// 1. INPUTS
// ══════════════════════════════════════════════════════════════════════════════
const string G_GEN  = "General"
const string G_KZ   = "Time Filter (New York)"
const string G_PANE = "HTF Candles"
const string G_MOD  = "Model Style"
const string G_PRJ  = "OrderBlock Projections"
const string G_LIQ  = "Liquidity (BSL / SSL)"
const string G_FVG  = "Fair Value Gaps"
const string G_SMT  = "SMT (TF aligned)"
const string G_TBL  = "Fractal Model Info Table"

ui_alerts  = input.bool(true, "Alerts", group = G_GEN)
ui_history = input.int(2, "History", minval = 0, maxval = 40, group = G_GEN, tooltip = "Number of Fractal Model setups (T-Spot / C2 / C3 / C4 / CISD / Projections) kept on the chart. 0 = current setup only.")
ui_bars    = input.int(2000, "Calculated Bars", minval = 300, maxval = 5000, group = G_GEN)
ui_fractal = input.string("Automatic", "Fractal", options = ["Automatic", "Custom"], inline = "fr", group = G_GEN)
ui_c2      = input.bool(true, "C2", inline = "cc", group = G_GEN)
ui_c3      = input.bool(true, "C3", inline = "cc", group = G_GEN)
ui_c4      = input.bool(true, "C4", inline = "cc", group = G_GEN)
ui_ctf1    = input.timeframe("60", "Custom TF 1 (primary)", group = G_GEN)
ui_ctf2    = input.timeframe("240", "Custom TF 2", group = G_GEN)
ui_ctf3    = input.timeframe("D", "Custom TF 3", group = G_GEN)
ui_bias    = input.string("Neutral", "Bias", options = ["Neutral", "Bullish", "Bearish", "Auto Bias 1", "Auto Bias 2"], group = G_GEN)

ui_apply   = input.string("1 hour", "Apply below", options = ["1 hour", "4 hours", "Daily"], group = G_KZ, tooltip = "The time filters below only apply while the chart timeframe is below this value.")
ui_f1 = input.bool(false, "Filter 1", inline = "f1", group = G_KZ)
ui_s1 = input.session("0200-0500", "", inline = "f1", group = G_KZ)
ui_f2 = input.bool(false, "Filter 2", inline = "f2", group = G_KZ)
ui_s2 = input.session("0800-1100", "", inline = "f2", group = G_KZ)
ui_f3 = input.bool(false, "Filter 3", inline = "f3", group = G_KZ)
ui_s3 = input.session("1330-1615", "", inline = "f3", group = G_KZ)

ui_htf_size = input.string("Small", "Size", options = ["Small", "Normal", "Large"], inline = "sz", group = G_PANE)
ui_htf_hide = input.bool(false, "Hide?", inline = "sz", group = G_PANE)
