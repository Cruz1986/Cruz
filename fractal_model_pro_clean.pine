ui_ic_on     = input.bool(true, "IC-CISD", inline = "ic", group = G_MOD, tooltip = "Same-side CISDs printed after the main CISD, until the T-Spot (and C4 after a C3) ends.")
ui_ic_max    = input.int(2, "max", minval = 1, maxval = 6, inline = "ic", group = G_MOD)
ui_dot_on    = input.bool(true, "Protected swing dot", inline = "dot", group = G_MOD)
