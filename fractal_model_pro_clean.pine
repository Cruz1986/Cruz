ui_single   = input.bool(false, "Single HTF mode (isolate)", group = G_PANE, tooltip = "Only the timeframe below is shown / used.")
ui_single_tf = input.string("4 hours", "Single HTF timeframe", options = ["15 minutes", "30 minutes", "45 minutes", "1 hour", "2 hours", "3 hours", "4 hours", "6 hours", "7 hours", "9 hours", "1 day", "1 week", "1 month"], group = G_PANE)
ui_single_n = input.int(6, "Single HTF candle count", minval = 4, maxval = 25, group = G_PANE)
