ui_proj_on  = input.bool(true, "Projections", inline = "p1", group = G_PRJ)
ui_proj_lv  = input.string("1, 2, 2.5", "", inline = "p1", group = G_PRJ)
ui_proj_lb  = input.bool(true, "Labels", inline = "p2", group = G_PRJ)
