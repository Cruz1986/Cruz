ui_pane_mid = input.bool(true, "EQ lines between pane candles (primary)", group = G_PANE)

ui_show_ttfm = input.bool(true, "Show TTFM labels", inline = "tt", group = G_MOD)
ui_ttfm_sz   = input.string("Small", "", options = ["Tiny", "Small", "Normal", "Large", "Huge"], inline = "tt", group = G_MOD)
ui_sw_on     = input.bool(true, "Candle 1 sweep", inline = "sw", group = G_MOD)
ui_sw_col    = input.color(color.black, "", inline = "sw", group = G_MOD)
