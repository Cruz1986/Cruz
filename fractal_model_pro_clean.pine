ui_layout   = input.string("Horizontal Next-to-Each-Other", "Layout", options = ["Horizontal Next-to-Each-Other", "Vertical Stacked (Same Offset)"], group = G_PANE)
ui_vgap     = input.float(1.2, "Vertical stacked gap multiplier", minval = 0.1, step = 0.1, group = G_PANE)
ui_n1       = input.int(6, "Primary HTF candle count", minval = 4, maxval = 25, group = G_PANE)
ui_n2       = input.int(4, "Second HTF candle count (0 = off)", minval = 0, maxval = 25, group = G_PANE)
