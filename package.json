{
  "name": "tamil-catholic-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "db:test": "scripts/db/test.sh",
    "test:e2e": "playwright test",
    "import:bible": "tsx scripts/import/bible.ts",
    "import:lectionary": "tsx --tsconfig tsconfig.json scripts/import/lectionary.ts",
    "calendar:generate": "tsx --tsconfig tsconfig.json scripts/calendar/generate.ts",
    "import:prayers": "tsx --tsconfig tsconfig.json scripts/import/prayers.ts",
    "import:rosary": "tsx --tsconfig tsconfig.json scripts/import/rosary.ts",
    "import:saints": "tsx --tsconfig tsconfig.json scripts/import/saints.ts",
    "load-test": "node scripts/load-test.mjs",
    "preflight": "tsx --tsconfig tsconfig.json scripts/preflight.ts",
    "admin:grant": "tsx --tsconfig tsconfig.json scripts/admin/grant-role.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  }
}
