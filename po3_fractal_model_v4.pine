htf_timer_color     = input.color(#b8b8b8, '', inline = 'htflbl', group = gHTFVis)
htf_label_position  = input.string('Both', 'Label Position', options = ['Both', 'Top', 'Bottom'], inline = 'lblpos', group = gHTFVis)
htf_label_alignment = input.string('Align', ' ', options = ['Align', 'Follow Candles'], inline = 'lblpos', group = gHTFVis)

htf_sweep_color        = input.color(#9c9c9c, 'Sweeps', inline = 'sweep', group = gHTFVis)
htf_sweeps_display     = input.string('HTF Pane + Main', ' ', options = ['HTF Pane Only', 'Main Chart Only', 'HTF Pane + Main'], inline = 'sweep', group = gHTFVis)
htf_sweep_display_mode = input.string('Recent Sweep Only', ' ', options = ['Recent Sweep Only', 'Last 2 Sweeps Only', 'Last 4 Sweeps Only', 'All Sweeps'], inline = 'sweep', group = gHTFVis)
htf_sweep_display_cap  = htf_sweep_display_mode == 'Recent Sweep Only' ? 1 : htf_sweep_display_mode == 'Last 2 Sweeps Only' ? 2 : htf_sweep_display_mode == 'Last 4 Sweeps Only' ? 4 : 100000

htf_auto               = input.bool(true, 'Auto Fractals?', group = gHTFSet, tooltip = 'Picks three HTF panes from the chart timeframe (e.g. 5m → 1H / 4H / 1D).')
htf_pane1_follow_model = input.bool(true, 'HTF1 follows Fractal Model HTF', group = gHTFSet, tooltip = 'ON: pane 1 always shows the same HTF the Fractal setups are built on (Model Settings), so the pane and the C2/C3/C4 engine agree. OFF: pane 1 uses Auto Fractals / TF Source.')
htf_custom_daily_open  = input.bool(false, 'Custom Daily Open', inline = 'customdaily', group = gHTFSet)
htf_custom_daily_time  = input.string('Midnight', '', options = ['Midnight', '18:00'], inline = 'customdaily', group = gHTFSet)

htf_sweeps_tf_1_show      = input.bool(false, 'HTF1', inline = 'CISD1', group = gHTFSet)
htf_pane_cisd_1_show      = input.bool(true, 'Plot CISD on HTF1?', inline = 'CISD1', group = gHTFSet)
htf_sweeps_tf_1_custom_tf = input.string('1h', 'TF Source', options = ['3m', '5m', '15m', '30m', '90m', '1h', '2h', '3h', '4h', '6h', '12h', 'D', '3D', 'W', 'M', '3M', '6M', '12M'], inline = 'TF1_source', group = gHTFSet)
htf_sweeps_tf_1_number    = input.int(9, 'Count', minval = 1, maxval = 25, inline = 'TF1_source', group = gHTFSet)

htf_sweeps_tf_2_show      = input.bool(true, 'HTF2', inline = 'CISD2', group = gHTFSet)
htf_pane_cisd_2_show      = input.bool(true, 'Plot CISD on HTF2?', inline = 'CISD2', group = gHTFSet)
htf_sweeps_tf_2_custom_tf = input.string('4h', 'TF Source', options = ['3m', '5m', '15m', '30m', '90m', '1h', '2h', '3h', '4h', '6h', '12h', 'D', '3D', 'W', 'M', '3M', '6M', '12M'], inline = 'TF2_source', group = gHTFSet)
