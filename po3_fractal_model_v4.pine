// © [CJ] PO3 Fractal Model V4 — PO3 shell (swings, FVGs, accumulation, breakers, dashboard)
//   + Fractal Model setup engine (C2 / C3 / C4, CISD, IC-CISD, SMT, entry zones, EQ, liquidity)
//   + HTF candle panes (sweeps, pane CISD, labels/timer), Key Levels, Dealing Range
//   + iFVG (inverted MTF FVGs) hooked to live Fractal setups

//@version=6
import fstarcapital/AssetCorrelationUtils/12 as ACL
indicator("[CJ] PO3 Fractal Model V4", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

// ══════════════════════════════════════════════════════════════════════════════
// 1. TYPES
// ══════════════════════════════════════════════════════════════════════════════

// ---- PO3 types ----
type AccZone
    float   h
    float   l
    int     startT
    line    highLine
    line    lowLine
    box     bgBox
    bool    activeHigh
    bool    activeLow
    bool    inFormation

type AccZoneRefs
    line    highLine
    line    lowLine
    box     bgBox

type Breaker
    box     b
    float   top
    float   btm
    bool    isBull
    bool    active
    bool    touched

type Swing
    line    ln
    label   lbl
    float   price
    bool    isHigh
    bool    mitigated
    int     t
    string  tfLabel
    color   col

type FVG
    float   top
    float   btm
    bool    isBull
    box     b
    line    ceLine
    label   lbl
    string  tf
    int     level
    bool    isTouched
    bool    isOverlapped

// Inverted FVG: a FVG that price closed through. Owned by the Fractal setup that was live at inversion.
type IFVG
    float   top
    float   btm
    bool    isBull          // true = bullish iFVG (bearish FVG closed above), false = bearish iFVG
    box     b
    line    ceLine
    label   lbl
    string  tf
    int     src_htf_idx     // htf_candle_idx of the owning Fractal setup (na when ungated)

// ---- Fractal Model types ----
type Candle
    float o
    float c
    float h
    float l
    int o_time
    int o_idx
    int c_idx
    int h_idx
    int l_idx

// Completed IC-CISD (confirmed only)
type ICCisd
    float level
    int start_idx
    int end_idx
    float extreme_price
    int extreme_idx

type Setup
    bool is_bullish          // true = bullish setup (low sweep), false = bearish (high sweep)
    bool is_confirmed        // true when sweep is confirmed (close in range)
    bool is_post_c2          // true after C2 closes, waiting for CISD
    // Sweep data
    float sweep_price        // swept high/low price (C1 high/low)
    int sweep_ltf_idx        // LTF bar index of sweep
    int sweep_bar_idx        // bar index where sweep happened (for CISD traceback)
    int swept_candle_idx     // HTF candle that was swept (o_idx)
    int htf_candle_idx       // HTF candle that did the sweeping
    int ltf_end_idx          // LTF end point for sweep line
    int htf_count            // counts HTF candles since sweep (max 2)
    // C2 data
    int c2_x                 // bar index for C2 label (at swing point)
    float c2_y               // price for C2 label (swing high/low)
    float c2_extreme         // C2's high (bearish) or low (bullish) for price limit
    // CISD data
    float cisd_level         // CISD price level (open of opposing candles)
    int cisd_start_idx       // bar index where CISD level starts
    int cisd_end_idx         // bar index where CISD line ends (bar after trigger)
    float tracked_extreme    // tracks high/low price for CISD (lowest low or highest high)
    int extreme_bar_idx      // bar index where the extreme occurred (for CISD traceback)
    bool has_cisd            // true when CISD level is set
    bool cisd_triggered      // true when close crosses through CISD level
    // IC-CISD (rebuild): opposite-candle open = level; body break confirms; one pending
    array<ICCisd> ic_list
    bool ic_active           // detection on after main CISD (through C4)
    bool ic_pending          // waiting for body break on current structure
    float ic_level           // open of opposite candle
    int ic_start_idx         // bar of that opposite candle
    float ic_extreme         // running high (bear) / low (bull) for dot — update every bar until confirm
    int ic_extreme_idx
    bool ic_seen_same_side   // true only after a real same-side candle (not doji) while pending
    float ic_last_extreme    // last confirmed IC swing extreme
    // Liquidity data (times are stamped when set, so drawing never needs deep history offsets)
    float liq_c1_price       // C1 low (bearish) or high (bullish)
    int liq_c1_start_idx     // LTF bar index where C1 low/high occurred
    int liq_c1_start_time    // time of that bar
    float liq_c0_price       // C0 low (bearish) or high (bullish) - na if condition not met
    int liq_c0_start_idx     // LTF bar index where C0 low/high occurred
    int liq_c0_start_time    // time of that bar
    int liq_end_time         // C4's end time (for extending lines)
    int liq_c1_mitigated_idx // Bar index where C1 liq was crossed (na if not mitigated)
    int liq_c1_mitigated_time
    int liq_c0_mitigated_idx // Bar index where C0 liq was crossed (na if not mitigated)
    int liq_c0_mitigated_time
    // Invalidation
    bool is_invalid          // True if C3 exceeded C2 extreme after CISD triggered
    // Entry Zone C3 data
    float c2_mid             // C2 wick midpoint (high+low)/2
    float c3_open            // C3 open price
    bool ez_c3_set           // true when C3 entry zone bounds are calculated
    float ez_c3_top          // C3 zone top price
    float ez_c3_bot          // C3 zone bottom price
    int ez_c3_left_time      // C3 zone left (C3 open time)
    int ez_c3_right_time     // C3 zone right (C3 close / C4 open); na while C3 is live
    // Entry Zone C4 data
    float c3_mid             // C3 wick midpoint (high+low)/2
    float c3_extreme         // C3 high (bearish) or low (bullish) for C4 invalidation
    float c4_open            // C4 open price
    bool ez_c4_set           // true when C4 entry zone bounds are calculated
    bool ez_c4_invalid       // true when C4 invalidated (beyond C3 extreme)
    int ez_c4_invalid_time   // LTF time where C4 was invalidated (EQ stops here)
    float ez_c4_top          // C4 zone top price
    float ez_c4_bot          // C4 zone bottom price
    int ez_c4_left_time      // C4 zone left (C4 open time)
    int ez_c4_right_time     // C4 zone right (C4 close)
    // SMT data
    bool has_smt             // SMT detected for this setup
    int smt_x1               // SMT line start bar index
    int smt_x2               // SMT line end bar index
    float smt_y1             // SMT line start price
    float smt_y2             // SMT line end price
    string smt_symbol        // Which symbol triggered SMT (for label)
    // StdDev / Breaker extras (re-hooked from PO3, triggered on CISD confirm)
    bool sd_drawn = false
    array<line> sd_lines = na
    array<label> sd_labels = na
    bool breaker_drawn = false
    Breaker breaker_ref = na

type CandleSettings
    string htf
    int max_display

type Settings
    bool sweep_show
    color sweep_color
    string sweep_style
    int sweep_size
    int sweep_history
    bool sweep_visible_only
    bool sweep_live
    color c2_color
    string c2_size
    bool cisd_show
    color cisd_bull_color
    color cisd_bear_color
    int cisd_width
    string cisd_style
    bool ic_cisd_show
    bool entry_zone_show
    color entry_zone_bull_color
    color entry_zone_bear_color
    bool alerts_enabled
    bool live_alerts_enabled
    bool liq_show
    color liq_color
    string liq_style
    int liq_width

type CandleSet
    array<Candle> candles
    array<Setup> setups       // completed setups for history
    CandleSettings settings
    Setup live_bearish        // tracks when high is wicked (potential bearish setup)
    Setup live_bullish        // tracks when low is wicked (potential bullish setup)
    bool has_live_bearish
    bool has_live_bullish

// Drawing Bin - centralized storage for all Fractal drawing objects (redrawn on last bar)
type DrawingBin
    array<line> lines
    array<box> boxes
    array<label> labels

// Tracks running high/low for SMT comparison symbols
type SMT_Tracker
    float h
    float l
    int h_idx
    int l_idx
    float prev_h
    float prev_l
    int prev_h_idx
    int prev_l_idx

// ══════════════════════════════════════════════════════════════════════════════
// 2. SETTINGS & PAIRING LOGIC (PO3)
// ══════════════════════════════════════════════════════════════════════════════

Settings settings = Settings.new()

group_model  = "Model Settings"
useAuto      = input.bool(true, "Auto-Select HTF?", group=group_model)
manualPair   = input.string("1m - 15m", "Preset Manual Pair", options=[
     "15s - 5m", "1m - 15m", "2m - 20m", "3m - 30m", "5m - 1H",
     "15m - 4H", "30m - 9H", "1H - 1D", "2H - 2D", "3H - 3D",
     "4H - 1W", "8H - 2W", "12H - 3W", "1D - 1M", "2D - 2M",
     "1W - 3M", "2W - 6M", "3W - 9M", "1M - 12M"
     ], group=group_model)
useCustomHTF = input.bool(false, "Use Custom HTF instead of Pair?", tooltip="Overrides Auto and Preset Pairs", group=group_model)
customHTF    = input.timeframe("60", "Custom HTF Timeframe", group=group_model)

tradeBias    = input.string("Both", "Setup Bias", options=["Bull", "Bear", "Both"], group=group_model)

group_vis    = "Visuals"
maxHistoryCount = input.int(15, "Max Recent CISD Displayed (SD / Breakers)", minval=1, maxval=25, group=group_vis, tooltip="Each setup draws 5 StdDev lines + 5 labels. Capped at 25 so the 500-object drawing limits are not exhausted.")
sdColor      = input.color(color.gray, "StdDev Color", group=group_vis)
textColor    = input.color(color.black, "Label Color", group=group_vis)
pivotLeftBars  = input.int(1, "Pivot Left Bars", minval=1, maxval=20, group=group_vis)
pivotRightBars = input.int(1, "Pivot Right Bars", minval=1, maxval=20, group=group_vis)

group_ema    = "EMA Settings"
showEma      = input.bool(true, "Show EMA", group=group_ema)
emaLen       = input.int(21, "EMA Length", minval=1, group=group_ema)
emaSrc       = input.source(hlc3, "EMA Source", group=group_ema)
emaColor     = input.color(color.blue, "EMA Color", group=group_ema)

group_swing = "Liquidity Swings"
showSwings  = input.bool(true, "Show Major (HTF) Swings", group=group_swing)
swLen       = input.int(5, "Major Swing Length", minval=2, group=group_swing)
majorLineStyle = input.string("Solid", "Major Swing Style", options=["Solid", "Dashed", "Dotted"], group=group_swing)

colSw4h     = input.color(color.gray, "4H Swing Color", group=group_swing)
colSw1d     = input.color(color.gray, "1D Swing Color", group=group_swing)
colSw1w     = input.color(color.gray, "1W Swing Color", group=group_swing)
colSw1m     = input.color(color.gray, "1M Swing Color", group=group_swing)

showMinorSwings = input.bool(true, "Show Minor (LTF) Swings", group=group_swing)
minorSwLen      = input.int(10, "Minor Swing Length", minval=2, group=group_swing)
minorSwingColor = input.color(color.gray, "Minor Swing Color", group=group_swing)
minorLineStyle  = input.string("Dashed", "Minor Swing Style", options=["Solid", "Dashed", "Dotted"], group=group_swing)
maxMitigatedKeep = input.int(8, "Mitigated Swings Kept (per group)", minval=0, maxval=50, group=group_swing, tooltip="Mitigated swing lines kept on chart as dotted history. Older ones are deleted so they do not eat the drawing-object limit.")

group_sep   = "HTF Separators"
showSep     = input.bool(true, "Show HTF Separators", group=group_sep)
maxSepCount = input.int(10, "Max Separators", minval=1, group=group_sep)
sepColor    = input.color(color.new(color.gray, 50), "Separator Color", group=group_sep)
sepStyle    = input.string("Dashed", "Line Style", options=["Solid", "Dashed", "Dotted"], group=group_sep)

group_acc_time = "Accumulation Zones (NY Time)"
showAccTime    = input.bool(true, "Show NY Time Accumulation Zones (<= 15m only)", group=group_acc_time)
maxAccZones    = input.int(3, "Max Accumulation Zones", minval=1, maxval=50, group=group_acc_time)
accTimeColor   = input.color(color.new(color.purple, 90), "NY Zone Background", group=group_acc_time)
accTimeLineCol = input.color(color.purple, "NY Zone Lines", group=group_acc_time)

group_kz     = "Kill Zone Filter (New York Time)"
useKZ        = input.bool(false, "Filter Setups by Time?", group=group_kz)

use_asia     = input.bool(false, "Asian", group=group_kz, inline="asia")
kz_asia_sess = input.session("2000-0000", "", group=group_kz, inline="asia")

use_lon      = input.bool(false, "London", group=group_kz, inline="lon")
kz_lon_sess  = input.session("0200-0500", "", group=group_kz, inline="lon")

use_am       = input.bool(false, "NY AM", group=group_kz, inline="am")
kz_am_sess   = input.session("0830-1200", "", group=group_kz, inline="am")

use_pm       = input.bool(false, "NY PM", group=group_kz, inline="pm")
kz_pm_sess   = input.session("1330-1600", "", group=group_kz, inline="pm")

use_sb       = input.bool(true, "Silver Bullet (CSV)", group=group_kz, inline="sb")
kz_sb_sess   = input.session("0300-0400,1000-1100", "", tooltip="Comma-Separated Values for multiple time windows.", group=group_kz, inline="sb")

use_macro    = input.bool(true, "Macros (CSV)", group=group_kz, inline="macro")
kz_macro_sess= input.session("0233-0300,0403-0430,0850-0910,0950-1010,1050-1110,1150-1210,1310-1340,1515-1545", "", tooltip="Comma-Separated Values for multiple time windows.", group=group_kz, inline="macro")

show_bg      = input.bool(false, "Highlight SB/Macro Backgrounds", group=group_kz)

group_ui     = "Interface"
showDash     = input.bool(true, "Show Dashboard", group=group_ui)
dashPosIn    = input.string("Bottom Right", "Dashboard Position", options=["Top Right", "Middle Right", "Bottom Right", "Top Left", "Middle Left", "Bottom Left"], group=group_ui)

group_fvg    = "MTF FVGs"
show_fvg_15m = input.bool(true, "15m", group=group_fvg, inline="tf1")
show_fvg_30m = input.bool(true, "30m", group=group_fvg, inline="tf1")
show_fvg_1h  = input.bool(true, "1H",  group=group_fvg, inline="tf1")
show_fvg_4h  = input.bool(true, "4H",  group=group_fvg, inline="tf2")
show_fvg_1d  = input.bool(true, "1D",  group=group_fvg, inline="tf2")
show_fvg_1w  = input.bool(true, "1W",  group=group_fvg, inline="tf2")
show_fvg_1m  = input.bool(true, "1M",  group=group_fvg, inline="tf2")
show_ifvg       = input.bool(true, "Show iFVG (inverted FVGs)", group=group_fvg, tooltip="When price CLOSES through a FVG, the gap is inverted and kept as an iFVG (support/resistance) instead of being removed.")
ifvg_setup_only = input.bool(true, "Only with a live Fractal setup", group=group_fvg, tooltip="ON: an inversion only becomes an iFVG when a confirmed, non-invalid Fractal setup in the same direction is live (bullish iFVG <- bullish setup). The iFVG is cleared together with that setup.\nOFF: every inversion is kept.")
ifvg_bull_col   = input.color(color.new(color.rgb(41, 98, 255), 80), "Bull iFVG", inline="ifvg", group=group_fvg)
ifvg_bear_col   = input.color(color.new(color.rgb(242, 54, 69), 80), "Bear iFVG", inline="ifvg", group=group_fvg)
max_ifvg        = input.int(10, "Max iFVGs", minval=1, maxval=50, group=group_fvg)

group_breaker = "Breaker Blocks"
showBreakers      = input.bool(true, "Show Breaker Blocks", group=group_breaker)
maxBreakerCount   = input.int(10, "Max Breaker Blocks", minval=1, maxval=50, group=group_breaker)
breakerBullColor  = input.color(color.new(color.blue, 80), "Bullish Breaker Color", group=group_breaker)
breakerBearColor  = input.color(color.new(color.red, 80), "Bearish Breaker Color", group=group_breaker)
breakerBrokenColor= input.color(color.new(color.gray, 88), "Broken Breaker Color", group=group_breaker)
breakerMitExtend  = input.int(3, "Extend Past Mitigation (Bars)", minval=0, maxval=20, group=group_breaker)

group_alerts = "Alerts"
alertLiqSweep = input.bool(true, "Alert: Any Liquidity Swept (No CISD Required)", group=group_alerts)
alertBreaker  = input.bool(true, "Alert: Price Tapped Into Breaker Block", group=group_alerts)

// ══════════════════════════════════════════════════════════════════════════════
// 3. FRACTAL MODEL INPUTS
// ══════════════════════════════════════════════════════════════════════════════

string group_setup      = "Fractal Setups (C2 / C3 / C4)"
string group_sweep      = "Sweeps / CISD / Entry Zones"
string group_liquidity  = "Formation Liquidity"
string group_smt        = "SMT Divergence"

alerts_enabled_input            = input.bool(true, 'Alerts?', group=group_setup, tooltip='To turn on the alerts:\n\n1) Make sure that the Alerts? toggle is ON.\n2) Right-click on the indicator on your chart.\n3) Click Add Alert on this indicator.\n4) Choose the Alert Name and confirm by clicking Create.\n\nNOTE: if you change any Settings, delete and re-create the alerts!')
settings.alerts_enabled         := alerts_enabled_input
settings.sweep_history          := input.int(10, 'History        ', minval=0, group=group_setup, inline='history')
settings.sweep_visible_only     := input.bool(true, '', tooltip='Number of historical setups to show:\n\n☑ ON: Setups inside the recent HTF window are always shown. This count adds older setups.\n\n☐ OFF: Only show this many setups total.', inline='history', group=group_setup)
maxDisplayInput                 = input.int(4, 'Recent HTF Candles (setup window)', minval=4, group=group_setup)
calculate_on_close              = input.bool(true, 'Calculate on Close?', tooltip='When enabled, live setup detection only runs when LTF candles close (better performance). New HTF candle creation always runs immediately.', group=group_setup)

sweep_show_input                = input.bool(true, 'Show Sweeps   ', group=group_sweep, inline='sweep')
settings.sweep_show             := sweep_show_input
settings.sweep_live             := input.bool(true, 'Show live setup', inline='sweep_live', group=group_sweep, active = sweep_show_input)
settings.live_alerts_enabled    := input.bool(true, 'Alert', inline='sweep_live', group=group_sweep, active = sweep_show_input and alerts_enabled_input, tooltip='Send "Potential" alerts when CISD triggers during live setup tracking')
settings.sweep_color            := input.color(color.rgb(0, 0, 0, 0), 'Color         ', inline='sweep_color', group=group_sweep, active = sweep_show_input)
settings.sweep_style            := input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='sweep_color', group=group_sweep, active = sweep_show_input)
settings.sweep_size             := input.int(1, '', options=[1, 2, 3, 4], inline='sweep_color', group=group_sweep, active = sweep_show_input)
settings.c2_color               := input.color(color.rgb(0, 0, 0), 'C2 Label      ', inline='c2', group=group_sweep)
settings.c2_size                := input.string(size.small, '', options=[size.tiny, size.small, size.normal, size.large], inline='c2', group=group_sweep)
cisd_show_input                 = input.bool(true, 'Show CISD     ', inline='cisd', group=group_sweep)
settings.cisd_show              := cisd_show_input
ic_cisd_show_input              = input.bool(false, 'IC-CISD', inline='cisd', group=group_sweep, tooltip='Same-side IC-CISD after main CISD confirm through C4 (stops on setup or C4 invalid). Uses CISD colors/width/style. Extreme marked with a dot.')
settings.ic_cisd_show           := ic_cisd_show_input
settings.cisd_bull_color        := input.color(color.rgb(41,98,255), 'Bull          ', inline='cisd_color', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
settings.cisd_bear_color        := input.color(color.rgb(242,54,69), 'Bear', inline='cisd_color', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
settings.cisd_width             := input.int(2, 'Width', options=[1, 2, 3, 4], inline='cisd_style', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
settings.cisd_style             := input.string('Solid', 'Style', options=['Solid', 'Dashed', 'Dotted'], inline='cisd_style', group=group_sweep, active = cisd_show_input or ic_cisd_show_input)
entry_zone_show_input           = input.bool(true, 'Entry Zone   ', inline='entry_zone', group=group_sweep)
settings.entry_zone_show        := entry_zone_show_input
settings.entry_zone_bull_color  := input.color(color.new(color.rgb(41, 98, 255), 85), 'Bullish', inline='entry_zone', group=group_sweep, active = entry_zone_show_input)
settings.entry_zone_bear_color  := input.color(color.new(color.rgb(242, 54, 69), 85), 'Bearish', inline='entry_zone', group=group_sweep, active = entry_zone_show_input)
prev_eq_show                    = input.bool(true, 'Previous EQ   ', inline='prev_eq', group=group_sweep)
prev_eq_color                   = input.color(color.rgb(0,0,0,0), '', inline='prev_eq', group=group_sweep, active = prev_eq_show)
prev_eq_style                   = input.string('Dotted', '', options=['Solid','Dashed','Dotted'], inline='prev_eq', group=group_sweep, active = prev_eq_show)
prev_eq_width                   = input.int(1, 'Width', options=[1,2,3,4], inline='prev_eq', group=group_sweep, active = prev_eq_show)


liq_show_input                  = input.bool(true, 'Enable Formation Liquidity?', group=group_liquidity)
settings.liq_show               := liq_show_input
settings.liq_color              := input.color(color.rgb(0, 0, 0), '', inline='liq_style', group=group_liquidity, active = liq_show_input)
settings.liq_style              := input.string('Dotted', '', options=['Solid', 'Dashed', 'Dotted'], inline='liq_style', group=group_liquidity, active = liq_show_input)
settings.liq_width              := input.int(1, 'Width', inline='liq_style', group=group_liquidity, active = liq_show_input)

smt_show_input                  = input.bool(true, 'Enable SMT?', inline='smt_enable', group=group_smt)
smt_alerts_input                = input.bool(true, 'Alerts?', inline='smt_enable', group=group_smt)
smt_label_show_input            = input.bool(true, 'Labels?', inline='smt_labels', group=group_smt, active = smt_show_input)
smt_label_size_input            = input.string('Small', '', options=['Tiny', 'Small', 'Normal', 'Large'], inline='smt_labels', group=group_smt, active = smt_show_input and smt_label_show_input)
smt_line_style_input            = input.string('Solid', '', options=['Solid', 'Dashed', 'Dotted'], inline='smt_style', group=group_smt, active = smt_show_input)
smt_line_width_input            = input.int(1, 'Width', options=[1, 2, 3, 4], inline='smt_style', group=group_smt, active = smt_show_input)
smt_color_input                 = input.color(color.rgb(156, 39, 176), '', inline='smt_color', group=group_smt, active = smt_show_input)
smt_mode_input                  = input.string('Automatic', 'SMT Mode', options=['Automatic', 'Manual'], inline='smt_mode', group=group_smt, active = smt_show_input)
smt_sym2_enable_input           = input.bool(true, 'Enable Second SMT?', inline='smt_mode', group=group_smt, active = smt_show_input)
smt_sym1_manual_input           = input.symbol('CME_MINI:ES1!', '1.', inline='smt_sym1', group=group_smt, active = smt_show_input and smt_mode_input == 'Manual')
smt_sym1_inverse_input          = input.bool(false, 'Inverse ?', inline='smt_sym1', group=group_smt, active = smt_show_input and smt_mode_input == 'Manual')
smt_sym2_manual_input           = input.symbol('CME_MINI:NQ1!', '2.', inline='smt_sym2', group=group_smt, active = smt_show_input and smt_mode_input == 'Manual' and smt_sym2_enable_input)
smt_sym2_inverse_input          = input.bool(false, 'Inverse ?', inline='smt_sym2', group=group_smt, active = smt_show_input and smt_mode_input == 'Manual' and smt_sym2_enable_input)

// SMT symbol resolution
acl_config                      = ACL.resolveCurrentChart()
smt_sym1_resolved               = smt_mode_input == 'Automatic' ? acl_config.secondary : smt_sym1_manual_input
smt_sym2_resolved               = smt_mode_input == 'Automatic' ? acl_config.tertiary : smt_sym2_manual_input
smt_sym1_inverse                = smt_mode_input == 'Automatic' ? acl_config.invertSecondary : smt_sym1_inverse_input
smt_sym2_inverse                = smt_mode_input == 'Automatic' ? acl_config.invertTertiary : smt_sym2_inverse_input

[smt_sym1_h, smt_sym1_l] = request.security(smt_sym1_resolved, "", [high, low], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[smt_sym2_h, smt_sym2_l] = request.security(smt_sym2_resolved, "", [high, low], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

var SMT_Tracker smt_tracker1 = SMT_Tracker.new()
var SMT_Tracker smt_tracker2 = SMT_Tracker.new()
var SMT_Tracker smt_tracker_curr = SMT_Tracker.new()

smt_sym1_ticker = smt_sym1_resolved != "" ? syminfo.ticker(smt_sym1_resolved) : ""
smt_sym2_ticker = smt_sym2_resolved != "" ? syminfo.ticker(smt_sym2_resolved) : ""

